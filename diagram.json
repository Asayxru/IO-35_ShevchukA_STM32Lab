{
  "version": 1,
  "author": "Student",
  "editor": "wokwi",

  "parts": [
    {
      "type": "board-st-nucleo-c031c6",
      "id": "board",
      "top": 0,
      "left": 0,
      "attrs": {}
    },

    {
      "type": "board-bmp180",
      "id": "bmp1",
      "top": -190,
      "left": 300,
      "attrs": {
        "temperature": "24",
        "pressure": "101325"
      }
    },

    {
      "type": "wokwi-potentiometer",
      "id": "pot1",
      "top": 190,
      "left": 300,
      "attrs": {
        "value": "512",
        "label": "ADC"
      }
    },

    {
      "type": "wokwi-pushbutton",
      "id": "btn1",
      "top": 190,
      "left": -250,
      "attrs": {
        "label": "USER",
        "key": "B",
        "bounce": "0"
      }
    },

    {
      "type": "wokwi-logic-analyzer",
      "id": "logic1",
      "top": -190,
      "left": -300,
      "attrs": {
        "channelNames": "SCL,SDA"
      }
    }
  ],

  "connections": [
    [ "board:3V3.1", "bmp1:3.3V", "red", [] ],
    [ "board:GND.1", "bmp1:GND", "black", [] ],
    [ "board:PB6", "bmp1:SCL", "yellow", [] ],
    [ "board:PB7", "bmp1:SDA", "green", [] ],

    [ "board:3V3.1", "pot1:VCC", "red", [] ],
    [ "board:GND.1", "pot1:GND", "black", [] ],
    [ "pot1:SIG", "board:PA1", "blue", [] ],

    [ "btn1:1.l", "board:PB0", "blue", [] ],
    [ "btn1:2.l", "board:GND.1", "black", [] ],

    [ "board:PB6", "logic1:D0", "yellow", [] ],
    [ "board:PB7", "logic1:D1", "green", [] ],

    [ "$serialMonitor:RX", "board:PA2", "", [] ],
    [ "$serialMonitor:TX", "board:PA3", "", [] ]
  ],

  "serialMonitor": {
    "display": "always",
    "newline": "lf",
    "convertEol": false
  },

  "dependencies": {}
}